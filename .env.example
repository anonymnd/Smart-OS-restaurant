# Local development
VITE_API_URL=http://127.0.0.1:8000
VITE_WS_URL=ws://127.0.0.1:8000

# Cloud database. For Supabase, use the pooler connection string and keep sslmode=require.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@POOLER_HOST:6543/postgres?sslmode=require
DATABASE_URL=

# Security hardening. Set these in production.
APP_SECRET=replace-with-a-long-random-secret
DEMO_PASSWORD=replace-demo-password
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,https://YOUR_APP_DOMAIN
SENSOR_API_KEY=replace-if-using-real-sensor-webhooks
